#!/usr/bin/env bash
# Rechaza cualquier atribución a un modelo en el mensaje (decisión del usuario: nunca se atribuye a un modelo).
# Criterio único, también aplicado a `git log` por tests/arquitectura/test_sin_atribucion.py:
#   1. cualquier trailer Co-authored-by / Assisted-by / Generated-by, sea quien sea el nombre;
#   2. cualquier mención a un modelo o a su casa (claude, anthropic, opus, sonnet, haiku, gpt, copilot, gemini);
#   3. las marcas de herramienta («Generated with», «Claude Code», el emoji de robot).
# Las líneas de comentario de git (#) no cuentan.
MODELOS='(claude|anthropic|opus|sonnet|haiku|gpt|copilot|gemini)'
cuerpo=$(grep -v '^#' "$1")
if printf '%s\n' "$cuerpo" | grep -Eiq '^[[:space:]]*(Co-Authored-By|Assisted-by|Generated-by)[[:space:]]*:' \
  || printf '%s\n' "$cuerpo" | grep -Eiq "(^|[^[:alnum:]])${MODELOS}([^[:alnum:]]|$)" \
  || printf '%s\n' "$cuerpo" | grep -Eiq 'Generated with|🤖'; then
  echo "✗ commit rechazado: el mensaje atribuye el trabajo a un modelo (trailer Co-authored-by/Assisted-by/Generated-by o mención a un modelo). Quítalo." >&2
  exit 1
fi
