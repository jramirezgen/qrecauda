# Contratos de imports de docs/DISENO.md §3. tests/arquitectura/test_contratos.py los ejecuta y comprueba que
# las capas de aquí son las mismas que declara qrecauda.CAPAS.
[importlinter]
root_package = qrecauda
include_external_packages = True

[importlinter:contract:capas]
name = C1: una capa sólo importa las de su derecha (entrada → api → composicion → adaptadores|presentacion → aplicacion → puertos → datos → dominio)
type = layers
layers =
    qrecauda.entrada
    qrecauda.api
    qrecauda.composicion
    qrecauda.adaptadores | qrecauda.presentacion
    qrecauda.aplicacion
    qrecauda.puertos
    qrecauda.datos
    qrecauda.dominio

[importlinter:contract:adaptadores-independientes]
name = C2: los adaptadores no se importan entre sí (cada uno implementa UN puerto)
type = independence
modules =
    qrecauda.adaptadores.aer
    qrecauda.adaptadores.ibm_runtime
    qrecauda.adaptadores.mthree
    qrecauda.adaptadores.nist
    qrecauda.adaptadores.estadistica
    qrecauda.adaptadores.aes_gcm
    qrecauda.adaptadores.prng
    qrecauda.adaptadores.almacen_json
    qrecauda.adaptadores.zne_pec
    qrecauda.adaptadores.min_entropia
    qrecauda.adaptadores.defectos
    qrecauda.adaptadores.declaracion_toml
    qrecauda.adaptadores.git
    qrecauda.adaptadores.libro_jsonl
    qrecauda.adaptadores.sonda_local
    qrecauda.adaptadores.temporizador_local
    qrecauda.adaptadores.productor_en_proceso

[importlinter:contract:nucleo-sin-transversal]
name = C3: dominio, datos, puertos, aplicación y presentación no importan transversal; les llega por puertos o ya validado
type = forbidden
source_modules =
    qrecauda.dominio
    qrecauda.datos
    qrecauda.puertos
    qrecauda.aplicacion
    qrecauda.presentacion
forbidden_modules =
    qrecauda.transversal
    qrecauda.adaptadores
    qrecauda.entrada

[importlinter:contract:dominio-puro]
name = C4: el dominio no toca SDKs, IO, reloj ni aleatoriedad global
type = forbidden
source_modules =
    qrecauda.dominio
forbidden_modules =
    qiskit
    qiskit_aer
    qiskit_ibm_runtime
    mthree
    nistrng
    cryptography
    matplotlib
    plotly
    requests
    subprocess
    socket
    time
    random
    secrets
    os
    datetime
    uuid
    tempfile
    threading

[importlinter:contract:sdk-solo-en-adaptadores]
name = C5: los SDKs cuánticos y de criptografía sólo los importan sus adaptadores
type = forbidden
source_modules =
    qrecauda.dominio
    qrecauda.datos
    qrecauda.puertos
    qrecauda.aplicacion
    qrecauda.presentacion
forbidden_modules =
    qiskit
    qiskit_aer
    qiskit_ibm_runtime
    mthree
    nistrng
    cryptography

[importlinter:contract:sdk-solo-en-adaptadores-borde]
name = C5b: api, composicion, entrada y transversal no importan un SDK DIRECTAMENTE (lo alcanzan por el adaptador que la composición elige)
type = forbidden
allow_indirect_imports = True
source_modules =
    qrecauda.api
    qrecauda.composicion
    qrecauda.entrada
    qrecauda.transversal
forbidden_modules =
    qiskit
    qiskit_aer
    qiskit_ibm_runtime
    mthree
    nistrng
    cryptography

[importlinter:contract:transversal-hoja]
name = C6: lo transversal es hoja — sólo depende de dominio.errores; entrada, api, composicion y adaptadores lo usan, él no sube
type = forbidden
source_modules =
    qrecauda.transversal
forbidden_modules =
    qrecauda.entrada
    qrecauda.api
    qrecauda.composicion
    qrecauda.presentacion
    qrecauda.adaptadores
    qrecauda.aplicacion
    qrecauda.puertos
    qrecauda.datos
